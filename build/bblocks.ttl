            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/bblock/ogc.ogc-utils.prov.ogc-prov-chain-forms> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/build/generateddocs/markdown/ogc-utils/prov/ogc-prov-chain-forms/index.md> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-09-17"^^xsd:date ;
    rdfs:seeAlso <bblocks://ogc.ogc-utils.prov.w3c-prov-jsonld> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/> ;
    skos:prefLabel "OGC PROV Chain: Array ⇄ Object Conversion" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/> ;
    dcat:keyword "ogc",
        "prov",
        "transform",
        "utils" ;

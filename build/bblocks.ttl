<bblocks://ogc.ogc-utils.prov.w3c-prov-base> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "W3C PROV Representation Base" ;
    dct:abstract "Cross-reference anchor for the W3C PROV data model (PROV-DM), shared by every concrete PROV serialization/representation profile (W3C PROV-N, PROV-XML, PROV-JSON, PROV-O/RDF, PROV-JSONLD). This block carries no concrete syntax of its own; each representation-specific sibling block declares `isProfileOf` this one and supplies its own schema/context/examples. It directly cross-references the canonical OGC PROV Chain schema blocks for the same PROV-DM concepts (`dependsOn`), and documents how those can be used as an `extensionPoints` substitution target for anyone wanting a specialized OGC PROV Chain profile."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-08T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/build/generateddocs/markdown/ogc-utils/prov/w3c-prov-base/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/bblock/ogc.ogc-utils.prov.w3c-prov-base> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/build/generateddocs/json-full/ogc-utils/prov/w3c-prov-base/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-09-17"^^xsd:date ;
    dct:source <https://www.w3.org/TR/prov-dm/>,
        <https://www.w3.org/TR/prov-o/>,
        <https://www.w3.org/TR/prov-overview/> ;
    rdfs:seeAlso <bblocks://ogc.ogc-utils.prov.ogc-prov-chain-forms> ;
    skos:closeMatch prov:Activity,
        prov:Agent,
        prov:Entity ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/> ;
    skos:prefLabel "W3C PROV Representation Base" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-prov-jsonld-alt/> ;
    dcat:keyword "base",
        "prov",
        "utils" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://www.w3.org/ns/prov-o#> ;
            prof:hasRole role:specification ] ;
